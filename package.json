{
  "name": "worldview",
  "version": "0.1.0",
  "description": "What your life is about, what game you are playing, and whether you are playing it well \u2014 as an MCP app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "src",
    "migrations",
    "dist-mcp"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "vite build --watch",
    "build": "vite build && bun scripts/inline-app.ts",
    "check": "tsc --noEmit",
    "test": "bun run build && bun test",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "demo": "bun run demo:setup && bun run dev",
    "demo:setup": "bun scripts/demo-setup.ts",
    "demo:seed": "wrangler d1 execute DB --local --file=seeds/demo.sql",
    "demo:reset": "rm -rf .wrangler/state && bun run db:local && bun run demo:seed",
    "corpus:upload": "bun scripts/upload-corpus.ts",
    "corpus:upload:remote": "bun scripts/upload-corpus.ts --remote",
    "bookmarks:import": "bun scripts/import-bookmarks.ts --local",
    "bookmarks:import:remote": "bun scripts/import-bookmarks.ts --remote",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.110.0"
  }
}
